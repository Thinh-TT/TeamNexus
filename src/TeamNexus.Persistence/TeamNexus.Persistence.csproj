<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TeamNexus.Persistence – the SINGLE DbContext + domain entities + EF configurations
    and the single EF Core migration chain for the whole modular monolith
    (see project-docs/04-database-design.md §1.1).
    Feature modules (Auth, later Board/Ai/Reporting) reference this project and register
    their services/endpoints on top of the shared model.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <!--
      Giai đoạn 14.7 Track B §B3 — pgvector support for EF Core. Needed for the `vector(1536)` column and
      the cosine-distance query behind Workspace RAG. The package ships only a net8.0 assembly, but its
      own README states the latest version works with EF Core 9 AND 10, and its only EF dependency floor is
      Npgsql.EntityFrameworkCore.PostgreSQL >= 9.0.1 (we are on 10.0.1). If a future EF major drops binary
      compatibility, the migration path is to drop this package and store the vector as text with a
      ValueConverter plus raw SQL for the cosine operator — recorded as a deliberate fallback.
    -->
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

</Project>
