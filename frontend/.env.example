# API endpoint the Vite dev server proxies /api to (local development)
VITE_DEV_API_TARGET=http://localhost:5000

# Optional: absolute API base (defaults to '/api' → Vite dev proxy).
# For production cross-origin deployment (e.g. Vercel frontend talking to Render backend API):
# VITE_API_BASE_URL=https://teamnexus-api.onrender.com
# NOTE: In Vite, VITE_* environment variables are embedded at BUILD TIME.
# If you change this value, you MUST re-run the build / redeploy.
